---
import { tinaField } from "@tinacms/astro/tina-field";
import Icon from "../Icon.astro";
import type { PageBlocksTimeline } from "../../../tina/__generated__/types";

interface Props { block: PageBlocksTimeline }
const { block } = Astro.props;
---
<section class="timeline">
  <div class="container">
    {block.title && <h2 class="timeline__heading" data-tina-field={tinaField(block, "title")}>{block.title}</h2>}
  </div>
  <ol class="timeline__list">
    {block.steps?.map((step) => step && (
      <li class="timeline__step" data-tina-field={tinaField(step)}>
        <div class="timeline__card">
          <div class="timeline__content">
            {step.kicker && <p class="timeline__kicker">{step.kicker}</p>}
            <h3 class="timeline__title">
              {step.href ? <a href={step.href} target="_blank" rel="noopener">{step.title}</a> : step.title}
            </h3>
            {step.text && <p class="timeline__text">{step.text}</p>}
          </div>
          <span class="timeline__icon"><Icon name={step.icon ?? "trophy"} /></span>
        </div>
        <span class="timeline__pin"></span>
      </li>
    ))}
  </ol>
</section>
