---
import { tinaField } from "@tinacms/astro/tina-field";
import Icon from "./Icon.astro";
import type { Global } from "../lib/content";

interface Props { global: Global; path: string }
const { global, path } = Astro.props;
const site = new URL(Astro.site ?? "https://amepp.org").hostname;
const isActive = (href?: string | null) => href === path;
---
<div class="container header-inner">
  <a class="logo" href="/" data-tina-field={tinaField(global, "logo")}>
    {global.logo && <img src={global.logo} alt={global.siteName ?? ""} width="300" height="64" />}
  </a>
  <button class="menu-toggle" type="button" aria-label="Menú" aria-expanded="false" data-menu-toggle>
    <Icon name="menu" class="icon-open" />
    <Icon name="close" class="icon-close" />
  </button>
  <nav class="main-nav" aria-label="Menú" data-tina-field={tinaField(global, "nav")}>
    <ul>
      {global.nav?.map((item) => item && (
        <li>
          <a
            href={item.href ?? "#"}
            class:list={{ active: isActive(item.href) }}
            aria-current={isActive(item.href) ? "page" : undefined}
            target={item.href?.startsWith("http") ? "_blank" : undefined}
            rel={item.href?.startsWith("http") ? "noopener" : undefined}
          >{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  {global.showSearch && (
    <form class="search" action="https://www.google.com/search" method="get" target="_blank" role="search">
      <input type="hidden" name="as_sitesearch" value={site} />
      <label class="sr-only" for="buscar">Buscar</label>
      <input id="buscar" type="search" name="q" placeholder="Busqueda" />
      <button type="submit" aria-label="Buscar"><Icon name="search" /></button>
    </form>
  )}
</div>
